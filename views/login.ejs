<%- include('layouts/header') %>
<%- include('layouts/navbar') %>

<main class="login-page-wrapper">
    <section class="section-padding login-section">
        <div class="container center">
            <div class="login-card-container">
                <div class="login-card-header">
                    <span class="editorial-subheading">THE HOUSE OF ALVORA</span>
                    <h1 class="login-title">Client Access</h1>
                    <p class="login-subtitle">
                        Sign in to access your personal wishlist, order history, and express client checkout.
                    </p>
                </div>

                <div class="login-card-body">
                    <!-- Google OAuth Login Button -->
                    <a href="/auth/google" class="btn btn-google-login">
                        <svg class="google-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                        </svg>
                        <span>CONTINUE WITH GOOGLE</span>
                    </a>

                    <div class="login-privacy-note">
                        <p>
                            By continuing, you agree to ALVORA's <a href="/terms">Terms of Service</a> and acknowledge our <a href="/privacy">Privacy Policy</a>.
                        </p>
                    </div>
                </div>

                <div class="login-card-footer">
                    <div class="perks-list">
                        <div class="perk-item">
                            <i class="ri-heart-3-line"></i>
                            <span>Save Wishlist Items</span>
                        </div>
                        <div class="perk-item">
                            <i class="ri-truck-line"></i>
                            <span>Track Express Delivery</span>
                        </div>
                        <div class="perk-item">
                            <i class="ri-shield-user-line"></i>
                            <span>Seamless Authentication</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('layouts/footer') %>
<%- include('layouts/scripts') %>

