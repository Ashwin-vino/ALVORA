<!-- Footer Newsletter / Brand Banner Section -->
<section class="footer-newsletter-section">
    <div class="footer-newsletter-container">
        <div class="footer-newsletter-content">
            <span class="editorial-subheading">THE ALVORA JOURNAL</span>
            <h2 class="editorial-heading">Subscribe to the House Newsletter</h2>
            <p class="editorial-text">
                Be the first to receive invitation-only collection previews, editorial stories, and exclusive seasonal offerings.
            </p>
        </div>
        <form action="/subscribe" method="POST" class="footer-newsletter-form">
            <div class="newsletter-input-group">
                <input 
                    type="email" 
                    name="email" 
                    class="newsletter-input" 
                    placeholder="Enter your email address" 
                    required 
                    autocomplete="email"
                >
                <button type="submit" class="newsletter-submit-btn">
                    <span>JOIN</span>
                    <i class="ri-arrow-right-line"></i>
                </button>
            </div>
            <p class="newsletter-disclaimer">By subscribing, you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
        </form>
    </div>
</section>

<!-- Main Footer Section -->
