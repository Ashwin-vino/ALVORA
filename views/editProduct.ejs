<%- include('layouts/header') %>
<%- include('layouts/navbar') %>

<main class="admin-page-wrapper">
    <!-- Header Banner -->
    <section class="admin-header-section">
        <div class="container">
            <div class="admin-header-content">
                <div>
                    <span class="editorial-subheading text-gold">ATELIER MANAGEMENT</span>
                    <h1 class="admin-title">Edit Creation</h1>
                    <p class="admin-description">Modify garment details, update stock numbers, or refresh editorial media.</p>
                </div>
                <div>
                    <a href="/admin" class="btn btn-outline">&larr; BACK TO DASHBOARD</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Edit Product Form Section -->
    <section class="section-padding admin-form-section">
        <div class="container">
            <% if ((typeof isOgAdmin !== 'undefined' && isOgAdmin) || (typeof isSubAdmin !== 'undefined' && isSubAdmin)) { %>
                <% if (typeof product !== 'undefined' && product) { %>
                    <div class="form-container-card">
                        <form action="/admin/edit-product/<%= product._id %>" method="POST" enctype="multipart/form-data" class="admin-product-form" id="editProductForm">
                            
                            <!-- Hidden Product ID -->
                            <input type="hidden" name="productId" value="<%= product._id %>">

                            <!-- 1. Basic Product Info -->
                            <div class="form-section-block">
                                <h3 class="block-title">1. BASIC CREATION DETAILS</h3>
                                <div class="form-grid">
                                    <div class="form-group full-width">
                                        <label for="name" class="form-label">Garment Name *</label>
                                        <input type="text" id="name" name="name" class="form-control" value="<%= product.name %>" required>
                                    </div>

                                    <div class="form-group">
                                        <label for="category" class="form-label">Category *</label>
                                        <select id="category" name="category" class="form-control" required>
                                            <option value="men" <%= product.category === 'men' ? 'selected' : '' %>>Men</option>
                                            <option value="women" <%= product.category === 'women' ? 'selected' : '' %>>Women</option>
                                            <option value="kids" <%= product.category === 'kids' ? 'selected' : '' %>>Kids</option>
                                            <option value="footwear" <%= product.category === 'footwear' ? 'selected' : '' %>>Footwear</option>
                                            <option value="accessories" <%= product.category === 'accessories' ? 'selected' : '' %>>Accessories</option>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label for="price" class="form-label">Price (USD $) *</label>
                                        <input type="number" id="price" name="price" step="0.01" min="0" class="form-control" value="<%= product.price %>" required>
                                    </div>

                                </div>
                            </div>

                            <!-- 2. Product description -->
                            <div class="form-section-block">
                                <h3 class="block-title">2. PRODUCT DESCRIPTION</h3>
                                <div class="form-grid">
                                    <div class="form-group full-width">
                                        <label for="description" class="form-label">Description & Editorial Story *</label>
                                        <textarea id="description" name="description" rows="4" class="form-control" required><%= product.description %></textarea>
                                    </div>

                                </div>
                            </div>

                            <!-- 3. Existing & New Images -->
                            <div class="form-section-block">
                                <h3 class="block-title">3. CURRENT IMAGE</h3>
                                <% if (product.images && product.images.length > 0) { %>
                                    <div class="current-images-preview-grid">
                                        <% product.images.forEach((imgUrl, idx) => { %>
                                            <div class="preview-img-card">
                                                <img src="<%= imgUrl %>" alt="<%= product.name %> image <%= idx + 1 %>">
                                                <span class="preview-img-badge"><%= idx === 0 ? 'PRIMARY' : 'GALLERY' %></span>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } %>

                                <div class="form-group full-width margin-top-md">
                                    <label for="images" class="form-label">Replace Primary Image (Optional file upload)</label>
                                    <input type="file" id="images" name="images" class="file-input-control" accept="image/jpeg,image/png,image/webp">
                                    <p class="file-help-text">Leave blank to retain the current product image.</p>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <div class="form-submit-row">
                                <button type="submit" class="btn btn-gold btn-large">
                                    <i class="ri-save-line"></i> UPDATE CREATION
                                </button>
                                <a href="/admin" class="btn btn-outline">CANCEL</a>
                            </div>
                        </form>
                    </div>
                <% } else { %>
                    <div class="center section-padding">
                        <h2>Product Not Found</h2>
                        <a href="/admin" class="btn btn-primary">RETURN TO DASHBOARD</a>
                    </div>
                <% } %>
            <% } else { %>
                <div class="access-denied-box center">
                    <h2>Access Restricted</h2>
                    <p>Only the designated house administrator can edit products.</p>
                    <a href="/" class="btn btn-primary">RETURN TO HOMEPAGE</a>
                </div>
            <% } %>
        </div>
    </section>
</main>

<%- include('layouts/footer') %>
<%- include('layouts/scripts') %>

